# ============ graphkb 配置示例 ============
# 复制为 .env 后填真实值（.env 已被 .gitignore 排除，不会入库）

# --- LLM (provider: anthropic | openai_compat | ollama | mock) ---
GKB_LLM_PROVIDER=anthropic
GKB_LLM_MODEL=deepseek-v4-flash
GKB_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/coding
GKB_LLM_API_KEY=your-api-key-here
GKB_LLM_MAX_TOKENS=8192
GKB_LLM_DISABLE_THINKING=false

# --- Embedding (provider: ollama | openai_compat | mock) ---
GKB_EMBEDDING_PROVIDER=ollama
GKB_EMBEDDING_MODEL=bge-m3
GKB_EMBEDDING_BASE_URL=http://localhost:11434
GKB_EMBEDDING_API_KEY=
GKB_EMBEDDING_DIM=1024
GKB_EMBEDDING_MAX_TOKEN_SIZE=8192

# --- Misc ---
GKB_WORKING_DIR=./data
GKB_LANGUAGE=Chinese
# 同进程跑多个库时必须各设一个唯一值（否则 doc_status 缓存会跨实例泄漏，见 backlog 条目 6）
GKB_WORKSPACE=

# --- 检索命中分层的预算（可不填，默认值已经 S7 五轮实测选定）---
# 这三个数只改变「允许多宽」，不改变命中判据（锚点 / 答案引用 / 最短路）。
GKB_HIT_TOP_K=5
GKB_MAX_HOPS=4
GKB_MAX_PATHS=6

# --- 文件上传大小上限（MB）---
GKB_MAX_UPLOAD_MB=50
